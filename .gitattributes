# GitHub Linguist attributes
godot/.godot/** linguist-generated

# Agent skills must stay LF (harness/tooling portability)
.agents/skills/** text eol=lf

# Preserve the pinned Godot AI upstream snapshot byte-for-byte.
godot/addons/godot_ai/** linguist-vendored -whitespace

# Third-party 3D sources are vendored; embedded-buffer glTF files are enormous
# single-line JSON documents and must not produce browser-hostile text diffs.
godot/assets/kenney3d/** linguist-vendored -whitespace
godot/assets/quaternius/** linguist-vendored -whitespace
godot/assets/quaternius/**/*.gltf binary
