# Production gameplay selects a real provider profile by default.
NPC_PROVIDER_PROFILE=openai/gpt-5.4-mini
OPENAI_API_KEY=

# Optional OpenAI-compatible ModelScope profile.
MODELSCOPE_BASE_URL=https://api-inference.modelscope.ai/v1
MODELSCOPE_API_KEY=

# Optional Alibaba Model Studio Qwen3.8-Max Preview profile.
# Derive the base URL from the Singapore workspace id:
# https://<workspace-id>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
MODEL_STUDIO_WORKSPACE_ID=
MODEL_STUDIO_BASE_URL=
MODEL_STUDIO_API_KEY=

# Optional local OpenAI-compatible endpoint.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
