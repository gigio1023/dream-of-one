{
  "name": "@dream-of-one/npc-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "same-order:attach-playability-reports": "tsx src/tools/attach-same-order-playability-reports.ts",
    "openai-codex:login": "tsx src/tools/openai-codex-device-login.ts",
    "openai-codex:usage": "tsx src/tools/report-openai-codex-live-usage.ts",
    "openai-codex:social-probe": "tsx src/tools/openai-codex-social-probe.ts",
    "openai:proposal-smoke": "tsx src/tools/openai-proposal-smoke.ts",
    "start": "node dist/index.js",
    "test": "node --test --import tsx --test-reporter spec test/integration/*.test.ts",
    "check": "npm run build && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.19.19",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2"
  }
}
