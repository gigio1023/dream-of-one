{
  "name": "@dream-of-one/npc-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx src/index.ts",
    "serve": "node --import tsx src/index.ts",
    "validate:storylets": "node --import tsx src/tools/validate-storylets.ts",
    "fixtures:generate": "node --import tsx src/tools/generate-session-fixtures.ts",
    "start": "node dist/index.js",
    "test": "node --test --import tsx --test-reporter spec test/integration/*.test.ts",
    "check": "npm run build && npm run validate:storylets && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.19",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
