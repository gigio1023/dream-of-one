{
  "name": "@dream-of-one/npc-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun run --bun tsc -p tsconfig.json",
    "dev": "bun --watch run src/index.ts",
    "serve": "bun run src/index.ts",
    "validate:storylets": "bun run src/tools/validate-storylets.ts",
    "fixtures:generate": "bun run src/tools/generate-session-fixtures.ts",
    "fixtures:run:generate": "bun run src/tools/generate-run-fixture.ts",
    "provider:smoke": "bun run src/tools/provider-smoke.ts",
    "serve:scripted": "bun run src/tools/scripted-session-server.ts",
    "start": "bun run dist/index.js",
    "test": "bun test test/integration/*.test.ts",
    "check": "bun run build && bun run validate:storylets && bun run test"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "openai": "^6.46.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20.19.19",
    "typescript": "^5.9.2"
  }
}
