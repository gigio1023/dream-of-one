{
  "name": "@dream-of-one/npc-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test --import tsx --test-reporter spec test/integration/*.test.ts",
    "check": "npm run build && npm run test",
    "ws8:evidence:backend": "node scripts/analyze_ws8_backend_evidence.mjs",
    "ws8:events:snapshot": "node scripts/export_ws8_events_snapshot.mjs",
    "ws8:metrics:backend": "node scripts/collect_ws8_regression_metrics.mjs",
    "ws8:rc:backend": "node scripts/package_ws8_rc_artifacts.mjs",
    "ws8:release-gate:backend": "node scripts/run_ws8_release_gate.mjs",
    "ws8:trajectory:verify": "node scripts/verify_ws8_trajectory_diversity.mjs",
    "ws8:rollback-drill": "node scripts/run_ws8_rollback_drill.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "mineflayer": "^4.35.0",
    "vec3": "^0.1.10"
  },
  "devDependencies": {
    "@types/node": "^20.19.19",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
