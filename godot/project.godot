; Engine configuration file.
; Dream of One — 2D top-down client (M1 rebuild).
; Godot 4.7 stable. See docs/tech/godot-2d-client.md.

config_version=5

[application]

config/name="Dream of One"
config/description="Same Order — 2D playable slice (M1)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/kenney2d/rpg-urban-pack/Tilemap/tilemap_packed.png"

[autoload]

Localization="*res://scripts/localization/localization.gd"
Session="*res://scripts/runtime/session.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1920
window/size/window_height_override=1080
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="fractional"

[internationalization]

locale/fallback="ko"

